diff --git a/src/NFcore/reactionClass.cpp b/src/NFcore/reactionClass.cpp
index f2c130a..a894d63 100755
--- a/src/NFcore/reactionClass.cpp
+++ b/src/NFcore/reactionClass.cpp
@@ -516,7 +516,19 @@ string ReactionClass::fire(double random_A_number, bool track) {
 	}
 
 	// Loop through the products (excluding added molecules) and remove from observables
+	//
+	// From here until the products are back in their observables and their
+	// reactions, the counts are of no state the system is in, so no rate that
+	// reads an observable is computed from them: each update is held and
+	// applied once, after (RuleWorld/nfsim#115). If the firing is left by an
+	// exception the hold is dropped and nothing is applied.
+	struct HeldFiringUpdates {
+		System *system;
+		~HeldFiringUpdates() { system->abandonDeferredFiringPropensityUpdates(); }
+	} heldFiringUpdates = { this->system };
+	(void)heldFiringUpdates;
 	if (this->onTheFlyObservables) {
+		this->system->beginDeferredFiringPropensityUpdates();
 		std::unordered_set<int> updatedComplexIds;
 
 		// molecule observables..
@@ -675,6 +687,10 @@ string ReactionClass::fire(double random_A_number, bool track) {
 			mol->updateRxnMembership(this, useConnectedUpdate);
 		}
 	}
+	// The products are counted again and are in their reactions: compute what
+	// was held, from this state.
+	if (this->onTheFlyObservables)
+		this->system->endDeferredFiringPropensityUpdates();
 
 	// update complex-scoped local functions for typeII dependencies
 	// NOTE: as a side-effect, dependent DOR reactions (via typeI molecule dependencies) will be updated
diff --git a/src/NFcore/system.cpp b/src/NFcore/system.cpp
index e33ed6f..9b1c910 100644
--- a/src/NFcore/system.cpp
+++ b/src/NFcore/system.cpp
@@ -899,6 +899,41 @@ void System::update_A_tot(ReactionClass *r, double old_a, double new_a)
 
 }
 
+bool System::noteHeldFiringPropensityUpdate(ReactionClass *r)
+{
+	if (!r->getReadsObservable())
+		return false;
+	if (r->markDeferredFiringUpdate(deferredFiringUpdateGeneration))
+		heldFiringReactions.push_back(r);
+	return true;
+}
+
+void System::beginDeferredFiringPropensityUpdates()
+{
+	if (!hasObservableDependentReactions)
+		return;
+	heldFiringReactions.clear();
+	++deferredFiringUpdateGeneration;
+	deferringFiringPropensityUpdates = true;
+}
+
+void System::endDeferredFiringPropensityUpdates()
+{
+	if (!deferringFiringPropensityUpdates)
+		return;
+	/* Reset the guard first, so each update below reaches the selector. No
+	 * held reaction's rate was computed in the span, so get_a() is still the
+	 * propensity the selector has for it. */
+	deferringFiringPropensityUpdates = false;
+	for (vector<ReactionClass *>::const_iterator it = heldFiringReactions.begin();
+			it != heldFiringReactions.end(); ++it) {
+		double old_a = (*it)->get_a();
+		double new_a = (*it)->update_a();
+		a_tot = selector->update(*it, old_a, new_a);
+	}
+	heldFiringReactions.clear();
+}
+
 
 double System::recompute_A_tot()
 {
