 }
 
@@ -58,9 +63,14 @@ void Observable::add( int n_matches )
 	// Next, we update our dependent reactions, if there are any
 	for (int r=0; r<n_dependentRxns; r++)
 	{
+		/* During a firing this count is of no state the system is in: the
