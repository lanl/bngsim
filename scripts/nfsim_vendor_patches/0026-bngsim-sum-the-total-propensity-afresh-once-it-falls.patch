From a641b51da17afdf61649c234ef5a3a702ca1ceb0 Mon Sep 17 00:00:00 2001
From: Bill Hlavacek <hlavacek@lanl.gov>
Date: Tue, 24 Nov 2026 13:57:22 -0700
Subject: [PATCH] bngsim: sum the total propensity afresh once it falls far,
 and fire above 0

DirectSelector kept the total propensity as a running sum, Atot - oldA +
newA, and summed it afresh only when a pick ran past the last reaction. A
propensity added to a large total is rounded to that total's spacing, and
is not given back when the large term is taken off again. With A + B -> C
at kf from 1000 of each beside 0 -> D at 1e-6, the sum held 0 once A and
B were gone at kf = 1e5, so D never fired, and 1.907e-6 at kf = 1e4, so D
fired at 1.9 times its rate (bngsim GH #1666). A pick that ran past the
last reaction did sum the propensities afresh, but System::a_tot kept the
stale total, and every later waiting time was drawn from it.

The selector now sums Atot from each reaction's get_a() once it has
fallen below 2^-10 of the largest value it has held since it was last
summed, or below 0. Each update rounds the sum by about an ulp of that
peak, so above the threshold n updates cost it at most n * 2^-42 of its
own value, and more nearly sqrt(n) * 2^-42: below the 2^-32 to which a
pick is drawn for 1024 updates at the worst and about a million as a
rule. update() only keeps the peak; the fall is tested where the total
is read, before a waiting time is drawn (getAtotForDraw(), new in
ReactionSelector, getAtot() by default) and before a pick. Within a
firing the total can dip and come back, as when a molecule that carries
nearly all of it leaves one reaction before it joins the next, and a sum
is a pass over every reaction where a pick may stop at the first: tested
in update(), it made a model with one such molecule beside 300 reactions
25% slower. Tested where the total is read, a sum comes at most once per
fall by a factor of 1024. A total that is not a number fails the test
and is kept, for the host to report. System::getNextRxn takes a_tot from
the selector after each pick.

stepTo, sim and singleStep fired nothing while a_tot was at or below
ATOT_TOLERANCE, 1e-9, a rate in the model's own time unit: 0 -> D at
5e-10 never fired, and 100 A decaying at 1e-10 stopped at 10, where the
total is 1e-9 (bngsim GH #1672). With the total kept close to its sum
they fire at any total above 0, and ATOT_TOLERANCE is gone. The selector picks no
reaction from a total that is not above 0: random(0) is 0, which the
first reaction passes with a propensity of 0. stepTo and sim then draw
again from the total the selector found.

Upstream master has rewritten DirectSelector but still keeps a running
total and ATOT_TOLERANCE, so this carry is to be ported again when the
base moves (bngsim GH #519).
---
 .../reactionSelector/directSelector.cpp       | 75 +++++++++++++++++++
 .../reactionSelector/reactionSelector.hh      | 15 ++++
 src/NFcore/system.cpp                         | 32 ++++++--
 3 files changed, 115 insertions(+), 7 deletions(-)

diff --git a/src/NFcore/reactionSelector/directSelector.cpp b/src/NFcore/reactionSelector/directSelector.cpp
index 5f75b1f..97710d5 100644
--- a/src/NFcore/reactionSelector/directSelector.cpp
+++ b/src/NFcore/reactionSelector/directSelector.cpp
@@ -13,6 +13,37 @@ using namespace std;
 using namespace NFcore;
 
 
+/* update() keeps Atot as a running sum, Atot - oldA + newA. Each update rounds
+ * it twice, each time by at most about half an ulp of the largest value the sum
+ * has held since it was last summed, so n updates leave it off by up to about
+ * n * 2^-52 of that peak. A propensity added to a large total is rounded to the
+ * total's spacing, and is not given back when the large term is taken off
+ * again. A slow channel at 1e-6 beside a fast one at 1e11 was lost outright
+ * once the fast one was 0, and beside one at 1e10 it came back as 1.907e-6
+ * (bngsim GH #1666).
+ *
+ * So Atot is summed afresh once it has fallen below 2^-10 of that peak, or
+ * below 0. Above that, n updates cost it at most n * 2^-42 of its own value,
+ * and more nearly sqrt(n) * 2^-42, since roundings fall either way. That stays
+ * below the 2^-32 of the total to which a pick is drawn (NfsimRNG::random) for
+ * 1024 updates at the worst and about a million as a rule.
+ *
+ * update() only keeps the peak. The fall is tested where the total is read:
+ * before a waiting time is drawn from it (getAtotForDraw()) and before a pick.
+ * Within a firing the total can dip and come back, as when a molecule that
+ * carries nearly all of it leaves one reaction before it joins the next. A sum
+ * is a pass over every reaction, where a pick stops at the one it draws, so a
+ * test in update() would cost such a model a pass per firing. Tested where the
+ * total is read, a sum comes at most once per fall by a factor of 1024, and
+ * never in a run whose total does not fall that far.
+ *
+ * The sum reads each reaction's get_a(), the propensities the running sum is
+ * made of, rather than computing every rate again as refactorPropensities()
+ * does.
+ *
+ * A total that is not a number fails the test and is kept: it is the model's
+ * own, and the host reports it. */
+static const double ATOT_RESUM_FRACTION = 1.0 / 1024.0;   // 2^-10
 
 
 DirectSelector::DirectSelector(vector <ReactionClass *> &rxns, System *sys) :
@@ -25,6 +56,7 @@ DirectSelector::DirectSelector(vector <ReactionClass *> &rxns, System *sys) :
 		reactionClassList[r] = rxns.at(r);
 		Atot += reactionClassList[r]->get_a();
 	}
+	markSummed();
 }
 
 
@@ -42,6 +74,37 @@ double DirectSelector::refactorPropensities()
 	for(int r=0; r<n_reactions; r++) {
 		Atot += reactionClassList[r]->update_a();
 	}
+	markSummed();
+	return Atot;
+}
+
+
+void DirectSelector::resumPropensities()
+{
+	Atot = 0;
+	for(int r=0; r<n_reactions; r++) {
+		Atot += reactionClassList[r]->get_a();
+	}
+	markSummed();
+}
+
+
+void DirectSelector::markSummed()
+{
+	AtotPeak = Atot > 0 ? Atot : 0;
+	AtotResumBelow = AtotPeak * ATOT_RESUM_FRACTION;
+}
+
+
+void DirectSelector::resumIfFallen()
+{
+	if(Atot < AtotResumBelow) resumPropensities();
+}
+
+
+double DirectSelector::getAtotForDraw()
+{
+	resumIfFallen();
 	return Atot;
 }
 
@@ -50,6 +113,10 @@ double DirectSelector::update(ReactionClass *r,double oldA, double newA)
 {
 	Atot-=oldA;
 	Atot+=newA;
+	if(Atot > AtotPeak) {
+		AtotPeak = Atot;
+		AtotResumBelow = AtotPeak * ATOT_RESUM_FRACTION;
+	}
 	return Atot;
 }
 
@@ -57,6 +124,14 @@ double DirectSelector::update(ReactionClass *r,double oldA, double newA)
 
 double DirectSelector::getNextReactionClass(ReactionClass *&rc)
 {
+	resumIfFallen();
+	// Nothing fires at a total of 0, or one that is not a number. random(0) is
+	// 0, which the first reaction would pass below with a propensity of 0; a
+	// pick that passed every reaction sums them afresh and comes back here.
+	if(!(Atot > 0)) {
+		rc = 0;
+		return 0;
+	}
 	double randNum = sys_->getRNG().random(Atot);
 
 	double a_sum=0, last_a_sum=0;
diff --git a/src/NFcore/reactionSelector/reactionSelector.hh b/src/NFcore/reactionSelector/reactionSelector.hh
index 9913aed..05031b9 100644
--- a/src/NFcore/reactionSelector/reactionSelector.hh
+++ b/src/NFcore/reactionSelector/reactionSelector.hh
@@ -39,6 +39,9 @@ namespace NFcore
 			virtual double update(ReactionClass *r,double oldA, double newA) = 0;
 			virtual double getNextReactionClass(ReactionClass *&rc) = 0;
 			virtual double getAtot() = 0;
+			/* The total to draw a waiting time from. A selector that keeps a
+			 * running total may sum it afresh first. */
+			virtual double getAtotForDraw() { return getAtot(); }
 
 		protected:
 			System *sys_;  // Pointer to System for accessing per-instance RNG
@@ -58,10 +61,22 @@ namespace NFcore
 			virtual double update(ReactionClass *r,double oldA, double newA);
 			virtual double getNextReactionClass(ReactionClass *&rc);
 			virtual double getAtot();
+			virtual double getAtotForDraw();
 
 
 		protected:
+			/* Sums Atot afresh from the propensity each reaction holds. */
+			void resumPropensities();
+			/* Starts the watch on Atot that has it summed again. */
+			void markSummed();
+			/* Sums Atot afresh if it has fallen far since it was last summed. */
+			void resumIfFallen();
+
 			double Atot;
+			/* The largest value Atot has held since it was last summed, and
+			 * the value below which it is summed again. */
+			double AtotPeak;
+			double AtotResumBelow;
 			int n_reactions;
 			ReactionClass ** reactionClassList;
 
diff --git a/src/NFcore/system.cpp b/src/NFcore/system.cpp
index 9b1c910..57270f1 100644
--- a/src/NFcore/system.cpp
+++ b/src/NFcore/system.cpp
@@ -18,8 +18,6 @@
 #include "../NFscheduler/NFstream.h"
 #include "../NFscheduler/Scheduler.h"
 
-#define ATOT_TOLERANCE 1e-9
-
 using namespace std;
 using namespace NFcore;
 
@@ -960,8 +958,13 @@ double System::getNextRxn()
 		// Upstream NFsim v1.14.3 consumes and discards the first selector draw
 		// here, then uses the second draw/residual. Keep this only as an
 		// explicit compatibility mode for same-seed parity with that CLI.
-		return selector->getNextReactionClass(nextReaction);
+		x = selector->getNextReactionClass(nextReaction);
 	}
+	// The selector sums the propensities afresh at a pick from a total that
+	// has fallen far, or at a draw past the last reaction, and picks from that
+	// sum, which a_tot then follows, so the next waiting time is drawn from it
+	// (bngsim GH #1666). With nothing to fire there it picks no reaction.
+	a_tot = selector->getAtot();
 	return x;
 
 
@@ -1023,7 +1026,9 @@ double System::sim(double duration, long int sampleTimes, bool verbose)
 		//   dt = -ln(rand) / a_tot;
 		//Choose a random number on the OPEN interval (0,1) so that we never
 		//have a dt=0 or a dt=infinity
-		if(a_tot>ATOT_TOLERANCE) delta_t = -log(rng_.random_open()) / a_tot;
+		// Summed afresh first if it has fallen far (bngsim GH #1666).
+		a_tot = selector->getAtotForDraw();
+		if(a_tot>0) delta_t = -log(rng_.random_open()) / a_tot;
 		else { delta_t=0; current_time=end_time; }
 		if(DEBUG) cout<<"   Determine dt : " << delta_t << endl;
 
@@ -1078,6 +1083,9 @@ double System::sim(double duration, long int sampleTimes, bool verbose)
 		//4: Select next reaction class based on smallest j,
 		//   such that sum of a_j over all j >= r2*a_tot
 		double randElement = getNextRxn();
+		// The selector found nothing to fire in the propensities summed
+		// afresh: draw again from the total it found.
+		if(nextReaction == NULL) continue;
 		
 		if(DEBUG && verbose && iteration < 5) {
 			cout << "Selected: " << (nextReaction ? nextReaction->getName() : "NULL") << endl;
@@ -1505,7 +1513,14 @@ double System::stepTo(double stoppingTime)
 		if(!pendingStepEventValid) {
 			// Preserve the pending waiting-time draw across output boundaries so
 			// repeated stepTo() calls consume the same RNG stream as sim().
-			if(a_tot > ATOT_TOLERANCE) {
+			// Any total above 0 has a reaction to fire: read for the draw, the
+			// selector sums the propensities afresh where rounding could have
+			// left a_tot far from their sum (bngsim GH #1666), and it picks
+			// nothing where that sum is 0. A threshold of 1e-9 here, a rate in
+			// the model's own time unit, fired nothing in a model whose total
+			// was that small (bngsim GH #1672).
+			a_tot = selector->getAtotForDraw();
+			if(a_tot > 0.0) {
 				pendingStepEventTime =
 					current_time + (-log(rng_.random_open()) / a_tot);
 				pendingStepEventValid = true;
@@ -1535,8 +1550,11 @@ double System::stepTo(double stoppingTime)
 		// Select and fire the next reaction
 		double randElement = getNextRxn();
 		if(nextReaction == NULL) {
+			// The selector found nothing to fire in the propensities summed
+			// afresh, so the waiting time was drawn from a stale total: draw
+			// again from the total it found.
 			invalidateStepToCache();
-			break;
+			continue;
 		}
 
 		current_time = pendingStepEventTime;
@@ -1566,7 +1584,7 @@ void System::singleStep()
 
 	recompute_A_tot();
 	cout<<"  -total propensity (a_total) calculated as: "<<a_tot<<endl;
-	if(a_tot>ATOT_TOLERANCE) delta_t = -log(rng_.random_open()) / a_tot;
+	if(a_tot>0) delta_t = -log(rng_.random_open()) / a_tot;
 	else
 	{
 		//Otherwise, we can't react for the rest of this step
-- 
