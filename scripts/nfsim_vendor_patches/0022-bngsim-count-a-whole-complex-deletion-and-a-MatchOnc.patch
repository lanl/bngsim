             if (hasMatchOnce) {
-                if (r->getRxnType() == ReactionClass::DOR_RXN || r->getRxnType() == ReactionClass::DOR2_RXN) {
-                    cerr << "Warning: MatchOnce is not yet supported for DOR/functional reactions. "
