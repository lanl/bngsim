+		Mapping * mapping = mappingSets[ deletedMolecules[d].first ]->get( deletedMolecules[d].second );
+		if ( mapping != NULL && mapping->getMolecule() != NULL )
+			deletedMols.push_back( mapping->getMolecule() );
