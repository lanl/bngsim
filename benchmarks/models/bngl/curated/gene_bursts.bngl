begin model

#@title: Bursty autoregulated gene expression (Lin and Doering, 2016)

#@description: |
#  Individual-based model of a positively autoregulated gene in Escherichia coli.
#  Protein activates transcription through a Hill function; each short-lived mRNA
#  is translated repeatedly before it decays, generating stochastic protein bursts,
#  while protein is diluted on the cell-cycle time scale. With the reported
#  parameterization the deterministic equations have one stable fixed point, but
#  intrinsic mRNA noise creates a bimodal stationary protein distribution.

#@keyword: |
#  gene regulation, stochastic bursts, positive feedback, Hill kinetics,
#  bimodal, intrinsic noise, Escherichia coli

#@reference: |
#  Lin YT, Doering CR (2016). Gene expression dynamics with stochastic bursts:
#  construction and exact results for a coarse-grained model. Physical Review E
#  93:022409. doi:10.1103/PhysRevE.93.022409

begin parameters
  # Population-conversion constants and single-cell reactor volume
  NA        6.02214076e23  # molecules/mol
  V_ref     1e-15          # L/cell

  # Mean lifetimes reported for bacterial mRNA and stable protein
  tau_mRNA     120   # s
  tau_Protein  3600  # s

  # First-order mRNA degradation and protein dilution rates
  gamma   1/tau_mRNA     # /s
  gamma0  1/tau_Protein  # /s

  # Mean number of translation events per transcript and the resulting rate
  B       40       # dimensionless
  gammaB  B*gamma  # /s

  # Basal and induced transcription rates; see Sec. II in Lin and Doering (2016)
  r0  2/3600   # molecules/s
  r1  10/3600  # molecules/s

  # Hill coefficient and half-activation protein copy number
  n  4    # dimensionless
  K  200  # molecules
end parameters

begin molecule types
  # Messenger RNA transcribed from the autoregulated gene
  mRNA()
  # Protein product that positively regulates transcription
  Protein()
end molecule types

begin seed species
  mRNA()    0  # molecules
  Protein() 0  # molecules
end seed species

begin observables
  # Cellular transcript and protein copy numbers
  Molecules Obs_Tot_mRNA    mRNA()
  Molecules Obs_Tot_Protein Protein()
end observables

begin functions
  # Hill-activated transcription propensity; Eq. 1a in Lin and Doering (2016)
  transcription_rate() = r0 + r1*Obs_Tot_Protein^n/(K^n + Obs_Tot_Protein^n)
end functions

begin reaction rules
  # Positive-autoregulatory transcription
  R_transcribe: 0 -> mRNA() transcription_rate()

  # Repeated translation preserves the transcript
  R_translate: mRNA() -> mRNA() + Protein() gammaB

  # Fast transcript degradation and slow protein dilution
  R_degrade_mRNA: mRNA() -> 0 gamma
  R_dilute_Protein: Protein() -> 0 gamma0
end reaction rules

end model

begin actions
  generate_network({overwrite=>1})  # 2 species, 4 reactions

  # Stationary protein distribution

  #@protocol: |
  #  Relax the deterministic mean-field model for ten 60-min cell cycles, then
  #  carry that state into a seeded 1000-cell-cycle Gillespie trajectory. Uniform
  #  180-s samples from the stochastic phase estimate the stationary protein
  #  distribution. This preserves the stateful ODE-to-SSA protocol in the source
  #  BNGL file while extending the sampling window for quantitative verification.

  #@figure: Fig. 3b in Lin and Doering (2016)

  simulate({method=>"ode",suffix=>"ode",t_start=>0,t_end=>36000,n_steps=>360,\
    print_functions=>1})
  simulate({method=>"ssa",suffix=>"ssa",t_start=>0,t_end=>3600000,n_steps=>20000,\
    seed=>220409,print_functions=>1})

  # Network-free alternative

  #@protocol: |
  #  The same finite model can be simulated with NFsim. This alternative is
  #  inactive because the published source model used generate-first SSA.

#  simulate({method=>"nf",suffix=>"nfr",t_start=>0,t_end=>3600000,n_steps=>20000,\
#    seed=>220409,print_functions=>1,gml=>2147483647})

  #@note: |
  #  Partial scaling is omitted because BioNetGen 2.9.3 aborts when the
  #  zeroth-order transcription rule receives a scaling factor below one.
end actions
