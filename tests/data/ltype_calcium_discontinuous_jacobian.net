# GH #176 regression fixture. Generated by BNG2.pl 2.9.3 from rulehub
# Examples/biology/ltypecalciumchanneldynamics/l-type-calcium-channel-dynamics.bngl,
# then EDITED -- k_v_stim is 49.99999999999 where the upstream model has 50.0.
# Do not "restore" it; the edit is the fixture. See lanl/bngsim#176.
#
# Its functional rate law v_rec = if((-70+Voltage_Level)<-20, 0.5, 0.05) is
# DISCONTINUOUS in the state Voltage_Level, i.e. it steps at Voltage_Level == 50.
# Voltage_Level obeys dV/dt = k_v_stim - k_v_leak*V, so it relaxes to
# k_v_stim/k_v_leak and never crosses the step -- it PARKS just below it, which is
# what the exact analytical Jacobian cannot represent: its derivative of a step is
# 0, so it cannot warn CVODE's corrector about a jump the predictor keeps landing
# on. CVODE's error test then fails repeatedly and h collapses to hmin (flag=-3).
# The finite-difference Jacobian perturbs V by srur*|V| = sqrt(u)*50 = 7.4e-7,
# which straddles the step and returns a large regularizing slope instead.
#
# Upstream k_v_stim is 50.0 with k_v_leak 1.0, i.e. the asymptote is EXACTLY the
# threshold. The parked value is then 50 +/- an ulp and which side of the step it
# lands on is decided by the last bit -- and FD's rescue exists only on the low
# side, where its perturbation reaches across. That is why the same binary
# integrated this model on one platform and died at t~34.6 on another.
#
# So the asymptote is moved a DEFINED 1e-11 below the threshold: 1407 ulps of 50,
# far enough that no platform's rounding can move V to the far side, and ~5 orders
# below the 7.4e-7 FD perturbation, so that perturbation still straddles the step
# on every platform. Both margins are what make the outcome a property of the
# model rather than of the host.
# Created by BioNetGen 2.9.3
begin parameters
    1 k_open_max      10.0  # Constant
    2 V_half          -15  # Constant
    3 k_slope         6  # Constant
    4 k_close         0.5  # Constant
    5 k_inact_max     5.0  # Constant
    6 Km_ca           200  # Constant
    7 k_ca_flux       15.0  # Constant
    8 k_ca_pump       0.8  # Constant
    9 k_pka_shift     -5.0  # Constant
   10 k_pka_on        2.0  # Constant
   11 LTCC_tot        500  # Constant
   12 Ca_init         50  # Constant
   13 PKA_stim        0  # Constant
   14 V_Clamp         -30.0  # Constant
   15 k_pka_current   0  # Constant
   16 k_v_stim        49.99999999999  # Constant
   17 k_v_leak        1.0  # Constant
   18 _rateLaw1       20.0  # Constant
   19 _rateLaw2       0.01  # Constant
end parameters
begin functions
    1 v_pka_shift() if((Phospho_LTCC>0),k_pka_shift,0)
    2 v_open() k_open_max/(1+exp(((-((-70+Voltage_Level)-(V_half+v_pka_shift())))/k_slope)))
    3 v_inact() k_inact_max*(Ca_Level/(Km_ca+Ca_Level))
    4 v_rec() if(((-70+Voltage_Level)<-20),0.5,0.05)
end functions
begin species
    1 LTCC(b,g~C,loc~mem,p~U,s~R) LTCC_tot
    2 Calcium() Ca_init
    3 Voltage() 1
    4 LTCC(b,g~O,loc~mem,p~U,s~R) 0
    5 LTCC(b,g~C,loc~mem,p~P,s~R) 0
    6 LTCC(b,g~O,loc~mem,p~P,s~R) 0
    7 LTCC(b,g~O,loc~mem,p~U,s~I) 0
    8 LTCC(b,g~C,loc~mem,p~U,s~I) 0
    9 LTCC(b,g~O,loc~mem,p~P,s~I) 0
   10 LTCC(b,g~C,loc~mem,p~P,s~I) 0
end species
begin reactions
    1 1 4 v_open #_R1
    2 2 0 k_ca_pump #_R6
    3 1 5 _rateLaw1 #_R7
    4 0 3 k_v_stim #_R9
    5 3 0 k_v_leak #_R10
    6 5 6 v_open #_R1
    7 4 1 k_close #_R2
    8 4 7 v_inact #_R3
    9 4 2,4 k_ca_flux #_R5
   10 4 6 _rateLaw1 #_R7
   11 5 1 _rateLaw2 #_R8
   12 6 5 k_close #_R2
   13 7 8 k_close #_R2
   14 6 9 v_inact #_R3
   15 7 4 v_rec #_R4
   16 6 2,6 k_ca_flux #_R5
   17 7 9 _rateLaw1 #_R7
   18 6 4 _rateLaw2 #_R8
   19 9 10 k_close #_R2
   20 8 1 v_rec #_R4
   21 9 6 v_rec #_R4
   22 8 10 _rateLaw1 #_R7
   23 9 7 _rateLaw2 #_R8
   24 10 5 v_rec #_R4
   25 10 8 _rateLaw2 #_R8
end reactions
begin groups
    1 Calcium_Inflow       2
    2 Conducting_R         4,6
    3 Inactivated_CH       7,8,9,10
    4 Potentiated_R        5,6,9,10
    5 Surface_LTCC         1,4,5,6,7,8,9,10
    6 Ca_Level             2
    7 Phospho_LTCC         5,6,9,10
    8 Voltage_Level        3
end groups
