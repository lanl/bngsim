# Regression fixture for issue #54: an if(t>=sigma) rate jump collapses the CVODE
# step size at sigma = 68.3718 (h ~ 5e-15, so t + h == t). CVODE returns
# CV_TOO_MUCH_WORK, and because the retry loop had no exit for a batch that made
# no progress, the run never returned — max_steps bounded a batch and never the
# number of batches, so raising it to 1,000,000 changed nothing and only the
# wall-clock `timeout` ever ended it. At default tolerances this must now fail in
# milliseconds with a SimulationError naming t and h; at rtol=atol=1e-7 the same
# model integrates normally and must still be allowed to.
#
# Derived from the reproducer in the issue (switch.bngl), transcribed to .net so
# the test needs no BNG2.pl.
begin parameters
    1 S0        19216182     # Constant
    2 sigma     68.3718      # Constant
    3 lam       9.744582     # Constant
    4 p0        0.4825392    # Constant
    5 beta      0.375        # Constant
    6 kL        0.94         # Constant
    7 _rateLaw1 beta/S0      # ConstantExpression
    8 kcount    1.0          # Constant
end parameters
begin species
    1 S_M()     19216182
    2 S_P()     0
    3 E()       1
    4 counter() 0
end species
begin observables
    1 Molecules t       counter()
end observables
begin functions
    1 Ptau()      if(t>=sigma,p0,0)
    2 Lambdatau() if(t>=sigma,lam,0)
    3 rM2P()      Lambdatau()*Ptau()
    4 rP2M()      Lambdatau()*(1-Ptau())
end functions
begin reactions
    1 0 4     kcount     #_R1
    2 1 2     rM2P       #_R2
    3 2 1     rP2M       #_R3
    4 1,3 3,3 _rateLaw1  #_R4
    5 3 0     kL         #_R5
end reactions
begin groups
    1 t       4
    2 S_M_obs 1
    3 S_P_obs 2
    4 E_obs   3
end groups
