# Issue #897 regression fixture. Generated by BNG2.pl 2.9.3 from rulehub
# Examples/ml/nnxor/nn_xor.bngl (parity_checks/bng_parity/models/fast/rulehub/
# Examples/ml/nnxor/nn_xor.bngl), unedited.
#
# Every rate law is the signed-rate idiom if(r>0, r, 0) / if(r<0, -r, 0), so a
# plain run roots each r. The output relaxation dY_dt() = (Sig_Y()-Y_Out)/Tau
# settles with Y_Out equal to Sig_Y() to the last bit, and near t = 155.4 its
# root fires with the flow opposing it, with the residual at exactly 0.0. The
# run steps on past such a root, and must not then read that zero as a second
# root at the same instant, which CVODE refuses with "Root found at and very
# near t" (CV_ILL_INPUT).
#
# Created by BioNetGen 2.9.3
begin parameters
    1 Tau           1.0  # Constant
    2 BaseEta       15.0  # Constant
    3 Gain          4.0  # Constant
    4 Bias          -0.5  # Constant
    5 DecayRate     0.1  # Constant
end parameters
begin functions
    1 W11_Net() W11_Pos-W11_Neg
    2 W12_Net() W12_Pos-W12_Neg
    3 W21_Net() W21_Pos-W21_Neg
    4 W22_Net() W22_Pos-W22_Neg
    5 V1_Net() V1_Pos-V1_Neg
    6 V2_Net() V2_Pos-V2_Neg
    7 Net_H1() ((In1*W11_Net())+(In2*W21_Net()))+Bias
    8 Sig_H1() 1/(1+exp(((-Gain)*Net_H1())))
    9 Net_H2() ((In1*W12_Net())+(In2*W22_Net()))+Bias
   10 Sig_H2() 1/(1+exp(((-Gain)*Net_H2())))
   11 Net_Y() ((H1_Act*V1_Net())+(H2_Act*V2_Net()))+Bias
   12 Sig_Y() 1/(1+exp(((-Gain)*Net_Y())))
   13 dH1_dt() (Sig_H1()-H1_Act)/Tau
   14 dH2_dt() (Sig_H2()-H2_Act)/Tau
   15 dY_dt() (Sig_Y()-Y_Out)/Tau
   16 Global_Error() (Truth-Y_Out)^2
   17 Target_DA() 1.0+(50.0*Global_Error())
   18 dDA_dt() (Target_DA()-DA)*5.0
   19 E_term() Truth-Y_Out
   20 Grad_V1() (E_term()*(Y_Out*(1-Y_Out)))*H1_Act
   21 Grad_W11() (((E_term()*(Y_Out*(1-Y_Out)))*V1_Net())*(H1_Act*(1-H1_Act)))*In1
   22 Rate_V1() (BaseEta*DA)*Grad_V1()
   23 Rate_W11() (BaseEta*DA)*Grad_W11()
   24 _rateLaw1() if((dH1_dt()>0),dH1_dt(),0)
   25 _rateLaw2() if((dH1_dt()<0),(-dH1_dt()),0)
   26 _rateLaw3() if((dH2_dt()>0),dH2_dt(),0)
   27 _rateLaw4() if((dH2_dt()<0),(-dH2_dt()),0)
   28 _rateLaw5() if((dY_dt()>0),dY_dt(),0)
   29 _rateLaw6() if((dY_dt()<0),(-dY_dt()),0)
   30 _rateLaw7() if((dDA_dt()>0),dDA_dt(),0)
   31 _rateLaw8() if((dDA_dt()<0),(-dDA_dt()),0)
   32 _rateLaw9() if((Rate_V1()>0),Rate_V1(),0)
   33 _rateLaw10() if((Rate_V1()<0),(-Rate_V1()),0)
   34 _rateLaw11() if((Rate_W11()>0),Rate_W11(),0)
   35 _rateLaw12() if((Rate_W11()<0),(-Rate_W11()),0)
end functions
