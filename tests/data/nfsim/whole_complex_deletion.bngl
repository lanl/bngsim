# Whole-complex deletion under NFsim (bngsim issue #1525).
#
# A rule that deletes a whole species (no DeleteMolecules) removes the complex
# the match sits in. BNG2.pl's network gives it one reaction per complex at the
# rule's rate, however many matches the complex holds. NFsim's reactant list holds
# one entry per match, so it fired such a rule once per match: a homodimer at 2k,
# a 4-ring at 4k. Each pool below starts at X0 complexes, independent of the rest.
#
#   AA    homodimer, A(d!1).A(d!1) -> 0             2 matches per complex
#   R4    4-ring, R(...)4 -> 0                      4 matches
#   MNM   M() -> 0 on asymmetric M(s~a).N.M(s~b)    2 matches
#   QQ    Q() -> 0 on a dimer, beside Q monomers    2 and 1: each complex at k
#   GG    homodimer, global function rate kg()      FunctionalRxnClass
#   HH    homodimer + catalyst X, k2*X = k          bimolecular
#   LKL   %x:L() -> 0 on L(s~a).K.L(s~b), local     DORRxnClass; BNG2.pl rates
#         function fl(x), 3k where La(x) > 0        the species 3k
#   JJ    {MatchOnce} homodimer                     counted per complex already
#   TT    homodimer, TotalRate kT                   total rate, not per complex
#   CD    heterodimer                               control: 1 match
#   BB    homodimer, DeleteMolecules                control: symmetry_factor 0.5
#   ZPP   Z(s!1,s!2).P(z!1).P(z!2), centre first    control: 1 match
#   M2a   M2(s~a) -> 0 on M2(s~a).N2.M2(s~b)        control: 1 match, beside a
#                                                   molecule of its type it misses
#
# Molecules observables only, so with block_same_complex_binding=False the
# System tracks no complexes and the count must come from bonds.
begin model
begin parameters
  k   1e-3
  k2  1e-5
  kT  2
  X0  2000
  NX  100
end parameters
begin molecule types
  A(d)
  R(a,b)
  M(s~a~b,g)
  N(m1,m2)
  Q(d)
  G(d)
  H(d)
  X()
  L(s~a~b,g)
  K(m1,m2)
  J(d)
  T(d)
  C(d)
  D(d)
  B(d)
  Z(s,s)
  P(z)
  M2(s~a~b,g)
  N2(m1,m2)
end molecule types
begin seed species
  A(d!1).A(d!1)                                X0
  R(a!1,b!4).R(a!2,b!1).R(a!3,b!2).R(a!4,b!3)  X0
  M(s~a,g!1).N(m1!1,m2!2).M(s~b,g!2)           X0
  Q(d!1).Q(d!1)                                X0
  Q(d)                                         X0
  G(d!1).G(d!1)                                X0
  H(d!1).H(d!1)                                X0
  X()                                          NX
  L(s~a,g!1).K(m1!1,m2!2).L(s~b,g!2)           X0
  J(d!1).J(d!1)                                X0
  T(d!1).T(d!1)                                X0
  C(d!1).D(d!1)                                X0
  B(d!1).B(d!1)                                X0
  Z(s!1,s!2).P(z!1).P(z!2)                     X0
  M2(s~a,g!1).N2(m1!1,m2!2).M2(s~b,g!2)        X0
end seed species
begin observables
  Molecules A_m    A()
  Molecules R_m    R()
  Molecules N_m    N()
  Molecules Qfree  Q(d)
  Molecules Qbound Q(d!+)
  Molecules G_m    G()
  Molecules H_m    H()
  Molecules K_m    K()
  Molecules J_m    J()
  Molecules T_m    T()
  Molecules C_m    C()
  Molecules B_m    B()
  Molecules Z_m    Z()
  Molecules La     L(s~a)
  Molecules N2_m   N2()
end observables
begin functions
  kg() = k
  fl(x) = if(La(x) > 0, 3*k, k)
end functions
begin reaction rules
  AA_del:  A(d!1).A(d!1) -> 0 k
  R4_del:  R(a!1,b!4).R(a!2,b!1).R(a!3,b!2).R(a!4,b!3) -> 0 k
  MNM_del: M() -> 0 k
  QQ_del:  Q() -> 0 k
  GG_del:  G(d!1).G(d!1) -> 0 kg()
  HH_del:  H(d!1).H(d!1) + X() -> X() k2
  LKL_del: %x:L() -> 0 fl(x)
  JJ_del:  {MatchOnce}J(d!1).J(d!1) -> 0 k
  TT_del:  T(d!1).T(d!1) -> 0 kT TotalRate
  CD_del:  C(d!1).D(d!1) -> 0 k
  BB_del:  B(d!1).B(d!1) -> 0 k DeleteMolecules
  ZPP_del: Z(s!1,s!2).P(z!1).P(z!2) -> 0 k
  M2a_del: M2(s~a) -> 0 k
end reaction rules
end model
generate_network({overwrite=>1})
writeXML()
