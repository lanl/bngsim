# Product-molecularity fixture: the bimolecular form of deleted_bridge_ring, on
# the default path. 100 rings A.B.X and 100 C(y~0); the rule deletes X and the
# A-B bond and flips C. Once X is gone A and B are apart, so BNG2.pl's network
# fires it: rings and C(y~0) fall together, 100 / (1 + 100 k t), so
# Afree(5) = 100 - 100/6 = 83.3. Main fired it; a search that walks through X
# never does (Afree 0).
begin model
begin parameters
  k 0.01
end parameters
begin molecule types
  A(b,x)
  B(a,x)
  X(a,b)
  C(y~0~1)
end molecule types
begin seed species
  A(b!1,x!3).B(a!1,x!2).X(b!2,a!3) 100
  C(y~0) 100
end seed species
begin observables
  Molecules Afree A(b,x)
end observables
begin reaction rules
  A(b!1,x!2).B(a!1).X(a!2) + C(y~0) -> A(b,x) + B(a) + C(y~1) k DeleteMolecules
end reaction rules
end model
writeXML()
