# Issue #897 regression fixture. Generated by BNG2.pl 2.9.3 from rulehub
# Examples/ml/mlqlearning/ml_q_learning.bngl (parity_checks/bng_parity/models/
# fast/rulehub/Examples/ml/mlqlearning/ml_q_learning.bngl), unedited.
#
# Q_Right and Q_Left meet exactly, with identical derivatives, so roots of the
# argmax switch (Q_Right-off)>(Q_Left-off) and of the policy residuals built on
# it land where the residual is exactly zero with no flow at all: the state lies
# ON those surfaces. A plain run must restart at such a root, so CVODE sets it
# aside until the residual leaves zero. Stepping on under the zero hold kept it
# armed instead, and every ~6e-11 wobble across the surface became another root:
# about 140,000 root returns, and a trajectory 4.9 off at rtol 1e-11.
#
# Created by BioNetGen 2.9.3
begin parameters
    1 goal        80.0  # Constant
    2 alpha       0.5  # Constant
    3 gamma       0.9  # Constant
    4 step_size   5.0  # Constant
    5 temp        5.0  # Constant
    6 off         50.0  # Constant
    7 _rateLaw7   1.0  # Constant
end parameters
begin functions
    1 ql() Q_Left-off
    2 qr() Q_Right-off
    3 reward() 100*exp((((-(Position-goal))^2)/500))
    4 p_right() 1/(1+exp(((-(qr()-ql()))/temp)))
    5 p_left() 1-p_right()
    6 net_action() step_size*(p_right()-p_left())
    7 max_q() if((qr()>ql()),qr(),ql())
    8 td_right() (reward()+(gamma*max_q()))-qr()
    9 td_left() (reward()+(gamma*max_q()))-ql()
   10 dqr() (alpha*p_right())*td_right()
   11 dql() (alpha*p_left())*td_left()
   12 _rateLaw1() if((net_action()>0),net_action(),0)
   13 _rateLaw2() if((net_action()<0),((-net_action())/max(Position,0.01)),0)
   14 _rateLaw3() if((dqr()>0),dqr(),0)
   15 _rateLaw4() if((dqr()<0),((-dqr())/max(Q_Right,0.01)),0)
   16 _rateLaw5() if((dql()>0),dql(),0)
   17 _rateLaw6() if((dql()<0),((-dql())/max(Q_Left,0.01)),0)
   18 _rateLaw8() if(((net_action()+off)>Act),((net_action()+off)-Act),0)
   19 _rateLaw9() if(((net_action()+off)<Act),(((Act-net_action())-off)/max(Act,0.01)),0)
end functions
begin species
    1 Pos() 10.0
    2 QL() 50.0
    3 QR() 50.0
    4 Reward() 0
    5 Action() 50.0
end species
begin reactions
    1 0 1 _rateLaw1 #_R1
    2 1 0 _rateLaw2 #_R2
    3 0 3 _rateLaw3 #_R3
    4 3 0 _rateLaw4 #_R4
    5 0 2 _rateLaw5 #_R5
    6 2 0 _rateLaw6 #_R6
    7 0 4 reward #_R7
    8 4 0 _rateLaw7 #_R8
    9 0 5 _rateLaw8 #_R9
   10 5 0 _rateLaw9 #_R10
end reactions
begin groups
    1 Position             1
    2 Q_Left               2
    3 Q_Right              3
    4 Rew                  4
    5 Act                  5
end groups
