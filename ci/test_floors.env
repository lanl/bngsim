# Test-count bounds for CI's false-green guards (issue #584).
#
# Each guard counts what its leg ran and calls ci/check_test_count.sh with one
# NAME from this file. Every NAME has a bound in one direction plus a slack:
#
#   NAME_FLOOR      the count must not fall below it: tests stopped being
#                   collected instead of failing, and the run stayed green
#                   (#28/#36).
#   NAME_CEILING    the count must not rise above it: tests turned into skips.
#   NAME_MAX_SLACK  how far the count may sit from that bound before the bound
#                   is STALE. A stale bound fails the job too.
#
# The stale check is why this file exists. These numbers used to sit in the
# workflows, and raising one was a chore nothing enforced. When #584 measured,
# the full suite collected 11288 tests against a floor of 3480, so two thirds
# of it could have vanished without the guard noticing. Now the run that
# outgrows a bound is the run that fails. Moving a bound is an edit to this file,
# outside .github/workflows/, so a token without the `workflow` scope can merge
# it.
#
# Each guard prints its count in the job log. When a floor goes stale, set it
# the distance below the count that its note gives, using the LOWEST count
# across the matrix legs where they differ. For a stale ceiling, set it that
# distance above the HIGHEST.
#
# "The run that fails" holds for merges one at a time. Two pull requests can
# each pass on their own merge refs and still, merged together, carry main past
# a slack. Main's next run then fails with the stale-bound message, and so does
# every open PR's run, until a one-line bump here lands. The legs whose paths
# filters list this file also fire on every bump, including bumps to bounds
# that are not theirs.
#
# Strict `NAME=integer` lines only. The helper parses this file rather than
# sourcing it, and python/tests/test_ci_count_bounds.py checks the format.

# --- python-tests.yml: the full suite (python/tests) -------------------------
#
# Collected = passed + skipped + xfailed + xpassed. Every leg agrees: 11288 on
# ubuntu, ubuntu-lapack and macos-14 at ec2f7f5, 12169 with #1015 (749 tests
# for the clock-condition scan) on 23fe4af, 12584 with the 415 of the
# event-loop tests (#950, #752) on that, 13101 on bbf04e1e (#1022's
# RuleMonkey tests with #1027's on main), 13591 for the lowest of the
# variable-volume pull requests in flight together (#1092 on 3c0a9305; #1087
# with main reads 13611, #1077 13629), and 13596 on dee08152 (#1108's shard
# tests, the first count summed over two shard jobs), and 14099 on 24edcf2b
# (#1089 with main at 6dbc17d1), and 14636 with #820's key-stream tests on
# 11826f29, and 15140 on ec574ff3 (#1208's MIR tests with main at a1a41acb),
# and 15714 on a720ba2f (#1243's steady-state tests with main at da171ad6).
# They agree because a CI
# checkout has no gitignored corpora. A developer checkout that has them reads
# higher: three tests parametrize over gitignored .net and SBML files, and the
# main checkout collected 14651 at the same commit. That is why this check runs
# in CI and not in a pytest meta-test. Set the floor 10 below the count.
#
# The slack trades how often the floor has to move against how much could go
# missing unnoticed. The suite grew by about 200 tests a day in Sep-Oct 2026,
# so 500 means a bump every two or three days and at most ~4% of the suite
# unwatched.
PYTEST_COLLECTED_FLOOR=15704
PYTEST_COLLECTED_MAX_SLACK=500

# Skipped. This replaced a passed-count floor (PASS_FLOOR). That floor's job was
# to catch a group of tests turning into skips for a declared reason, such as an
# extra that silently failed to install. A floor under a count that grows by
# hundreds a week cannot stay near it; a ceiling on skips does not move when
# tests are added. Per leg at ec2f7f5: ubuntu 195, macos-14 170,
# ubuntu-lapack 169. Set the ceiling 30 above the highest leg. The slack has to
# cover that 30 plus the spread between legs (26), with room left over for skips
# to be fixed on one leg.
#
# One ceiling serves all three legs, so it is only as sharp as its headroom on
# each: a group of up to 30 new skips passes on ubuntu, 55 on macOS and 56 on
# lapack. That catches an extra failing to install only when the extra
# gates more tests than that.
PYTEST_SKIPPED_CEILING=225
PYTEST_SKIPPED_MAX_SLACK=80

# --- python-tests.yml: the parity-harness unit tests (parity_checks/tests) ---
#
# 702 collected and 29 skipped on every leg at 7ef8f20 (PR #1019 with #1024's
# event-instant tests merged in), and 745 collected on 805141ad (#1105's
# stochastic wall-time tests, 4f7294c3, with main at 2495de79), and 801 with
# #1211's non-finite-rate tests on main at 02bb3046 (780 there), and 857 with
# #804's fd_sens tests (26) on main at 1e15ccea (831 there). The collected
# count is environment-independent for the same structural reason as above. The
# suite grows by a few tests a day. Set the floor 10 below the count and the
# ceiling 10 above.
PARITY_COLLECTED_FLOOR=847
PARITY_COLLECTED_MAX_SLACK=50
PARITY_SKIPPED_CEILING=39
PARITY_SKIPPED_MAX_SLACK=20

# --- windows-nfsim.yml: the NFsim cluster on windows-latest ------------------
#
# Passed, because the leg separately requires zero skips: 297 with #892. The
# smallest files hold 3 tests, so no floor can catch every file disappearing.
# The zero-skip check is this leg's sharp edge, and the floor backs it up for a
# file that stops being collected. Set it 8 below the count.
NFSIM_PASSED_FLOOR=289
NFSIM_PASSED_MAX_SLACK=16

# --- windows-klu.yml: the sparse/KLU cluster on windows-latest ---------------
#
# 20 passed at a8d38b1: 13 sparse-Jacobian tests plus 7 steady-state routing
# tests. Set the floor 2 below the count. The slack stays below 7, so losing the
# smaller file always trips the floor.
KLU_PASSED_FLOOR=18
KLU_PASSED_MAX_SLACK=6

# --- native-tests.yml: the C++ suite -----------------------------------------
#
# Test binaries ctest registered: 6 on both legs at 7476a51. That is every
# add_test() outside the NFsim block of tests/CMakeLists.txt, since this job
# builds without NFsim. The guard exists to trip when ANY one binary is lost,
# so the floor is the count and there is no slack. Registering a seventh binary
# means raising it.
CTEST_BINARIES_FLOOR=6
CTEST_BINARIES_MAX_SLACK=0

# RUN_TEST cases inside test_bngsim, which ctest sees as a single binary: 63 on
# both legs at 7476a51. Losing a case there is the exact #28/#36 failure, and
# cases are added rarely, so the floor is the count.
TEST_BNGSIM_CASES_FLOOR=63
TEST_BNGSIM_CASES_MAX_SLACK=5
